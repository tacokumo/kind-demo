repositories:
- name: tacokumo
  url: https://tacokumo.github.io/helm-charts

releases:
- name: tacokumo-admin
  namespace: tacokumo-admin
  createNamespace: true
  chart: tacokumo/tacokumo-admin
  version: 0.2.0
  values:
  - values/tacokumo-admin.yaml
  - github:
      oauth:
        callbackUrl: "{{ .StateValues.githubOAuthCallbackUrl }}"
        allowedOrgs: "{{ .StateValues.githubOAuthAllowedOrgs }}"
- name: portal-controller-kubernetes
  namespace: portal-controller-system
  createNamespace: true
  chart: tacokumo/portal-controller-kubernetes
  version: 0.3.0
  values: 
  - values/portal-controller-kubernetes.yaml
